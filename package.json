{
  "name": "media-intel",
  "version": "0.1.0",
  "description": "Consolidated MCP server for media understanding: probe, transcribe, frames, scenes, OCR",
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "mcp",
    "media",
    "ffmpeg",
    "transcription",
    "video"
  ],
  "author": "",
  "license": "MIT",
